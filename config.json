    "Hotkeys":  [
                    {
                        "Key":  "^+4",
                        "Macro":  "UI_Hotkeys.Hotkey_ApplyCustomNumberFormat",
                        "CommandName":  "ApplyCustomNumberFormat",
                        "Description":  "Apply custom number format"
                    },
                    {
                        "Key":  "^+p",
                        "Macro":  "UI_Hotkeys.Hotkey_MakePermanent",
                        "CommandName":  "MakePermanent",
                        "Description":  "Make selection permanent (values)"
                    },
                    {
                        "Key":  "+{F11}",
                        "Macro":  "UI_Hotkeys.Hotkey_CreateNamedSheet",
                        "CommandName":  "CreateSheet",
                        "Description":  "Create named sheet"
                    },
                    {
                        "Key":  "^%{DOWN}",
                        "Macro":  "UI_Hotkeys.Hotkey_FillDown",
                        "CommandName":  "FillDown",
                        "Description":  "Fill formula/format down"
                    },
                    {
                        "Key":  "^+f",
                        "Macro":  "UI_Hotkeys.Hotkey_FilterBySelectedCell",
                        "CommandName":  "FilterByCell",
                        "Description":  "Filter by selected cell"
                    },
                    {
                        "Key":  "^+m",
                        "Macro":  "UI_Hotkeys.Hotkey_PasteFormat",
                        "CommandName":  "PasteFormat",
                        "Description":  "Paste formats only"
                    },
                    {
                        "Key":  "^+q",
                        "Macro":  "UI_Hotkeys.Hotkey_FormatSelectedRange",
                        "CommandName":  "FormatRange",
                        "Description":  "Format selected range"
                    },
                    {
                        "Key":  "{BACKSPACE}",
                        "Macro":  "UI_Hotkeys.Hotkey_Backspace",
                        "CommandName":  "Backspace",
                        "Description":  "Clear cell contents"
                    },
                    {
                        "Key":  "{DELETE}",
                        "Macro":  "UI_Hotkeys.Hotkey_Delete",
                        "CommandName":  "Delete",
                        "Description":  "Clear or delete selection"
                    }
